{
  "name": "codex-reset-watch",
  "version": "1.0.0",
  "description": "Watch local Codex quota windows and notify when an unexpected reset occurs.",
  "type": "module",
  "bin": {
    "codex-reset-watch": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "RELEASING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt",
    "packaging/homebrew"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node --check web/theme.js && node --check web/app.js && node --check web/sw.js",
    "check:version": "node scripts/check-version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/**/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check:web && npm run build && npm run build:web && npm run check:version",
    "release:check": "npm run verify && npm audit --audit-level=high",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "codex",
    "cli",
    "rate-limit",
    "web-push",
    "ios"
  ],
  "license": "MIT",
  "homepage": "https://github.com/erovelli/codex-reset-watch#readme",
  "bugs": {
    "url": "https://github.com/erovelli/codex-reset-watch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erovelli/codex-reset-watch.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.17.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "web-push": "^3.6.7"
  }
}
