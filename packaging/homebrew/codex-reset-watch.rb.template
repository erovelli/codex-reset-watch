class CodexResetWatch < Formula
  desc "Notify when a local Codex weekly quota resets unexpectedly"
  homepage "https://github.com/erovelli/codex-reset-watch"
  url "RELEASE_TARBALL_URL"
  sha256 "SHA256"
  license "MIT"
  version "VERSION"

  depends_on "node"

  def install
    libexec.install Dir["*"]
    bin.install_symlink libexec/"dist/cli.js" => "codex-reset-watch"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/codex-reset-watch --version")
    assert_match "install", shell_output("#{bin}/codex-reset-watch --help")
  end
end
